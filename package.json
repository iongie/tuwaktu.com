    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.2.0",
    "@angular-devkit/schematics": "~22.2.0",
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@angular/language-service": "~22.2.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "24.0.3",
    "@nx/eslint": "24.0.3",
