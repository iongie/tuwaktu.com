{
  "name": "tuwaktu",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many --target=build --all",
    "build:dev": "nx run-many --target=build --all -c development",
    "build:staging": "nx run-many --target=build --all -c staging",
    "build:prod": "nx run-many --target=build --all -c production",
    "test": "nx run-many --target=test --all",
    "serve:web": "cross-env PORT=4200 nx serve web -c development",
    "serve:web:dev": "cross-env PORT=4200 nx serve web -c development",
    "serve:web:staging": "cross-env PORT=4200 nx serve web -c staging",
    "serve:web:prod": "cross-env PORT=4200 nx serve web -c production",
    "build:web": "nx build web",
    "build:web:dev": "nx run web:build:development",
    "build:web:staging": "nx run web:build:staging",
    "build:web:prod": "nx run web:build:production",
    "serve:ssr": "nx run web:serve-ssr:development",
    "serve:ssr:dev": "nx run web:serve-ssr:development",
    "serve:ssr:staging": "nx run web:serve-ssr:staging",
    "serve:ssr:prod": "nx run web:serve-ssr:production",
    "serve:api": "nx serve api -c development",
    "serve:api:dev": "nx serve api -c development",
    "serve:api:staging": "nx serve api -c staging",
    "serve:api:prod": "nx serve api -c production",
    "build:api": "nx build api",
    "build:api:dev": "nx run api:build:development",
    "build:api:staging": "nx run api:build:staging",
    "build:api:prod": "nx run api:build:production",
    "db:migrate": "cross-env APP_ENV=development go run ./cmd/migrate up",
    "db:migrate:dev": "cross-env APP_ENV=development go run ./cmd/migrate up",
    "db:migrate:staging": "cross-env APP_ENV=staging go run ./cmd/migrate up",
    "db:migrate:prod": "cross-env APP_ENV=production go run ./cmd/migrate up",
    "db:revert": "cross-env APP_ENV=development go run ./cmd/migrate down",
    "db:revert:dev": "cross-env APP_ENV=development go run ./cmd/migrate down",
    "db:revert:staging": "cross-env APP_ENV=staging go run ./cmd/migrate down",
    "db:revert:prod": "cross-env APP_ENV=production go run ./cmd/migrate down",
    "db:status": "cross-env APP_ENV=development go run ./cmd/migrate status",
    "db:status:dev": "cross-env APP_ENV=development go run ./cmd/migrate status",
    "db:status:staging": "cross-env APP_ENV=staging go run ./cmd/migrate status",
    "db:status:prod": "cross-env APP_ENV=production go run ./cmd/migrate status",
    "db:seed": "cross-env APP_ENV=development go run ./cmd/migrate seed",
    "db:seed:dev": "cross-env APP_ENV=development go run ./cmd/migrate seed",
    "db:seed:staging": "cross-env APP_ENV=staging go run ./cmd/migrate seed",
    "db:seed:prod": "cross-env APP_ENV=production go run ./cmd/migrate seed",
    "admin:unlock": "cross-env APP_ENV=development go run ./cmd/migrate unlock-admin",
    "admin:unlock:dev": "cross-env APP_ENV=development go run ./cmd/migrate unlock-admin",
    "admin:unlock:staging": "cross-env APP_ENV=staging go run ./cmd/migrate unlock-admin",
    "admin:unlock:prod": "cross-env APP_ENV=production go run ./cmd/migrate unlock-admin"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/build-angular": "~22.2.0",
